<div class="select is-fullwidth">
  <select
    name="{{ .Name }}"
    id="{{ .InputID }}"
    data-sa-relation
    data-options-url="{{ .OptionsURL }}"
    data-current="{{ .Value }}"
  >
    <option value="">—</option>
    {{ if .Value }}<option value="{{ .Value }}" selected>{{ .Value }}</option>{{ end }}
  </select>
</div>
