package views

// Form is the full create/edit screen (title + form body).
templ Form(vm FormView) {
	<section class="section">
		<h1 class="title">
			if vm.Mode == "create" {
				New { vm.Label }
			} else {
				Edit { vm.Label }
			}
		</h1>
		@FormBody(vm)
	</section>
}

// FormBody is the <form> itself. It is returned standalone (HTTP 422) on
// validation failure so HTMX can swap it in place with inline errors.
templ FormBody(vm FormView) {
	<form
		id="sa-form"
		if vm.UsePut {
			hx-put={ vm.Action }
		} else {
			hx-post={ vm.Action }
		}
		hx-target="#sa-form"
		hx-swap="outerHTML"
	>
		if vm.FormError != "" {
			<div class="notification is-danger is-light">{ vm.FormError }</div>
		}
		for _, f := range vm.Fields {
			<div class="field">
				<label class="label">{ f.Label }</label>
				<div class="control">
					if f.CustomHTML != "" {
						@templ.Raw(string(f.CustomHTML))
					} else {
						switch f.Kind {
						case "boolean":
							<label class="checkbox">
								<input type="checkbox" name={ f.Name } value="true" checked?={ f.Checked }/>
								{ " " + f.Label }
							</label>
						case "enum":
							<div class="select">
								<select name={ f.Name }>
									<option value="">—</option>
									for _, opt := range f.Enum {
										<option value={ opt } selected?={ opt == f.Value }>{ opt }</option>
									}
								</select>
							</div>
						case "object", "array":
							<textarea
								class={ "textarea", templ.KV("is-danger", f.Error != "") }
								name={ f.Name }
								placeholder="JSON"
							>{ f.Value }</textarea>
						default:
							<input
								class={ "input", templ.KV("is-danger", f.Error != "") }
								type={ f.InputType }
								name={ f.Name }
								value={ f.Value }
								if f.Required {
									required
								}
							/>
						}
					}
				</div>
				if f.Error != "" {
					<p class="sa-field-error">{ f.Error }</p>
				}
			</div>
		}
		<div class="field is-grouped">
			<div class="control">
				<button class="button is-primary" type="submit">Save</button>
			</div>
			<div class="control">
				<a class="button is-light" href={ templ.SafeURL(vm.CancelURL) }>Cancel</a>
			</div>
		</div>
	</form>
}
