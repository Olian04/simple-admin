package views

// Credentials renders the per-backend credential entry page. Values are saved
// to the browser's localStorage by credentials.js — never posted to the server.
templ Credentials(vm CredentialsView) {
	<section class="section">
		<h1 class="title">Credentials</h1>
		<p class="subtitle is-6">
			Stored in your browser only (localStorage). simple-admin never persists them;
			they are sent as passthrough to the matching backend on each request.
		</p>
		if len(vm.Backends) == 0 {
			<p>No backends configured.</p>
		}
		for _, b := range vm.Backends {
			<div class="box">
				<h2 class="subtitle is-5">{ b.Label }</h2>
				if b.NeedsCred {
					<div class="field">
						<label class="label">{ schemeLabel(b) }</label>
						<div class="field has-addons">
							<div class="control is-expanded">
								<input
									class="input"
									type="password"
									autocomplete="off"
									placeholder="credential value"
									data-sa-cred-input
									data-backend={ b.ID }
								/>
							</div>
							<div class="control">
								<button class="button is-primary" data-sa-cred-save data-backend={ b.ID }>Save</button>
							</div>
							<div class="control">
								<button class="button" data-sa-cred-clear data-backend={ b.ID }>Clear</button>
							</div>
						</div>
					</div>
				} else {
					<p>No authentication required.</p>
				}
			</div>
		}
	</section>
}
