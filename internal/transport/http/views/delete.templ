package views

// DeleteConfirm is a Bulma modal asking to confirm deletion. It is loaded into
// #sa-modal via HTMX. Confirm issues hx-delete; on success the server replies
// with HX-Redirect to the list. Cancel/background close via the data-sa-close
// delegated handler (CSP-safe — no inline JS).
templ DeleteConfirm(vm DeleteView) {
	<div class="modal is-active">
		<div class="modal-background" data-sa-close></div>
		<div class="modal-card">
			<header class="modal-card-head">
				<p class="modal-card-title">Delete { vm.Label }</p>
				<button class="delete" aria-label="close" data-sa-close></button>
			</header>
			<section class="modal-card-body">
				if vm.Error != "" {
					<div class="notification is-danger is-light">{ vm.Error }</div>
				}
				<p>Delete this { vm.Label } record? This cannot be undone.</p>
			</section>
			<footer class="modal-card-foot">
				<button
					class="button is-danger"
					hx-delete={ uiPath(vm.Backend.ID, vm.Name, vm.ID) }
					hx-target="#sa-modal"
					hx-swap="innerHTML"
				>Delete</button>
				<button class="button" data-sa-close>Cancel</button>
			</footer>
		</div>
	</div>
}
